<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Exercise 09</title>
<style>
  .wrap {
    width: 600px;
    padding: 10px;
    box-shadow: 0 0 10px gray;
  }
  .box1 {
    background-color: lightblue;
    border: 6px double Tomato;
  }
  .box2 {
    background-color: yellow;
    border: 3px solid DodgerBlue;
    border-radius: 10px;
  }
  .box3 {
    background-color: MediumSeaGreen;
    border: thick dotted gray;
  }
</style>
</head>
<body>
  <div class="wrap">
    <h1 class="box1">Hello World</h1>
    <h1 class="box2">Hello World</h1>
    <h1 class="box3">Hello World</h1>
  </div>
</body>
</html>
